# Elysia Agent 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# 注意: .env 在 .gitignore 中，切勿提交包含真实 API key 的 .env 文件！

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_BETA=https://api.deepseek.com/beta

# Milvus 向量数据库 (可选)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:your-password

# MiMo API (https://mimo.dev/)
MIMO_API_KEY=sk-your-key-here

# Tavily API (https://www.tavily.com/)
TAVILY_API_KEY=tvly-dev-your-key-here
