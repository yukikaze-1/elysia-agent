# Elysia Agent 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# 注意: .env 在 .gitignore 中，切勿提交包含真实 API key 的 .env 文件！

# =============================================================================
# LLM — 必需（至少配一个）
# =============================================================================

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI API (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-key-here

# MiMo API (https://mimo.dev/)
# MIMO_API_KEY=sk-your-key-here

# Custom LLM provider (OpenAI 兼容协议)
# CUSTOM_LLM_API_KEY=sk-your-key-here

# =============================================================================
# TTS — 语音合成（可选，config.yaml 中 tts.model 决定用哪个）
# =============================================================================

# GPT-SoVits 本地部署
# GPT_SOVITS_URL=http://localhost:9880

# MiniMax 云端 TTS (https://platform.minimaxi.com)
# MINIMAX_API_KEY=sk-your-key-here
# MINIMAX_TTS_URL=https://api.minimaxi.com  # 可选，默认 api.minimaxi.com

# OpenAI 兼容 TTS (custom provider)
# CUSTOM_TTS_API_KEY=sk-your-key-here

# =============================================================================
# STT — 语音识别（可选）
# =============================================================================

# SenseVoice 本地部署（默认）
# STT_API_URL=http://localhost:20042

# OpenAI 兼容 STT
# OPENAI_API_KEY=sk-your-key-here  # 与 LLM 共享同一个 key
# STT_API_KEY=sk-your-key-here

# Custom STT provider
# CUSTOM_STT_API_KEY=sk-your-key-here

# Deepgram STT (https://console.deepgram.com)
# DEEPGRAM_API_KEY=sk-your-key-here

# =============================================================================
# Embedding — 向量嵌入（可选，默认 HuggingFace 本地模型）
# =============================================================================

# OpenAI embedding (https://platform.openai.com)
# OPENAI_API_KEY=sk-your-key-here  # 与 LLM 共享同一个 key
# OPENAI_API_BASE=https://api.openai.com/v1

# =============================================================================
# 数据库 — 持久化存储（可选，降级到文件存储）
# 用 docker compose up -d 启动后无需修改以下配置
# =============================================================================

# Milvus 向量数据库 — 长期记忆
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# MongoDB 文档数据库 — token 追踪等
# MONGODB_URI=mongodb://localhost:27017

# =============================================================================
# 工具 — 可选
# =============================================================================

# Tavily 网页搜索 (https://www.tavily.com/)
# TAVILY_API_KEY=tvly-dev-your-key-here
