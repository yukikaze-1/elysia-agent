# Elysia Agent 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# 注意: .env 在 .gitignore 中，切勿提交包含真实 API key 的 .env 文件！

# =============================================================================
# LLM — 必需（至少配一个）
# =============================================================================

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_URL=https://api.deepseek.com
# DEEPSEEK_BETA_URL=https://api.deepseek.com/beta

# OpenAI API (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_URL=https://api.openai.com/v1

# Ollama 本地 LLM
# OLLAMA_URL=http://localhost:11434/v1

# MiMo API (https://mimo.dev/)
# MIMO_API_KEY=sk-your-key-here
# MIMO_URL=https://api.xiaomimimo.com/v1

# Custom LLM provider (OpenAI 兼容协议)
# CUSTOM_LLM_API_KEY=sk-your-key-here

# =============================================================================
# 服务绑定 / 远程访问（可选）
# =============================================================================

# 默认绑定 127.0.0.1（config.yaml server.host）。远程测试机直连时覆盖为 0.0.0.0，
# scripts/start.sh 即可远程启动（无需改 config.yaml 或传 --host）。
# SERVER_HOST=0.0.0.0

# 非回环绑定 + 未配 AGENT_ACCESS_TOKEN → 启动被 fail-closed 拒绝；开发期远程测试
# 用此开关放行匿名（生产请改用 AGENT_ACCESS_TOKEN + HTTPS）。
# ALLOW_INSECURE_REMOTE=1

# =============================================================================
# 鉴权 — 两个 token 是**两个授权域**，不要混用（CR-03）
# =============================================================================

# 产品 token：业务面（/ws、/api/*、/uploads/*）的 Bearer 凭据。
# 未配置时回环开发允许匿名；非回环绑定则 fail-closed 拒绝启动。
# AGENT_ACCESS_TOKEN=<openssl rand -hex 32>

# 管理 token：管理面（/debug/api/*、/shutdown、/restart、/tools、/tools/reload）
# 的凭据。**未配置 = 管理面不对任何 token 开放**（不再回退 AGENT_ACCESS_TOKEN，
# 见 CODE_REVIEW_REPORT §CR-03）。要用 /debug 数据面必须显式设置本项。
# SERVER_AUTH_TOKEN=<openssl rand -hex 32>

# 附件下载短签密钥（HMAC）。未配置时附件签名下载不可用（fail-closed）。
# ATTACHMENT_SIG_SECRET=<openssl rand -hex 32>

# =============================================================================
# TTS — 语音合成（可选，config.yaml 中 tts.model 决定用哪个）
# =============================================================================

# GPT-SoVits 本地部署
# GPT_SOVITS_URL=http://localhost:9880

# MiniMax 云端 TTS (https://platform.minimaxi.com)
# MINIMAX_API_KEY=sk-your-key-here
MINIMAX_TTS_URL=https://api.minimaxi.com

# OpenAI 兼容 TTS (custom provider)
# CUSTOM_TTS_API_KEY=sk-your-key-here

# =============================================================================
# STT — 语音识别（可选）
# =============================================================================

# SenseVoice 本地部署（默认）
# SENSEVOICE_URL=http://localhost:20042

# OpenAI 兼容 STT
# OPENAI_API_KEY=sk-your-key-here  # 与 LLM 共享同一个 key
# OPENAI_STT_URL=https://api.openai.com/v1

# Custom STT provider
# CUSTOM_STT_API_KEY=sk-your-key-here

# Deepgram STT (https://console.deepgram.com)
# DEEPGRAM_API_KEY=sk-your-key-here
# DEEPGRAM_URL=https://api.deepgram.com/v1

# =============================================================================
# Embedding — 向量嵌入（必需，setup.sh 自动下载本地模型）
# =============================================================================

# OpenAI embedding (https://platform.openai.com)
# OPENAI_API_KEY=sk-your-key-here  # 与 LLM 共享同一个 key
# OPENAI_API_BASE=https://api.openai.com/v1

# =============================================================================
# 数据库 — 持久化存储（必需）
# 用 docker compose --profile dev up -d 启动（生产用 --profile production）。
# 首次安装运行 bash scripts/setup.sh 会自动生成下面的随机数据库密码并写入 .env；
# 手动配置时请为每个密码用强随机值（如 openssl rand -hex 24），并保持：
#   Mongo/root 密码 6-72 位；Milvus root 密码 6-72 位；MinIO 密码 >= 8 位。
# 规则（P1-19）：Mongo/MinIO/Milvus 宿主端口仅绑定 127.0.0.1，凭据缺一即 compose 拒启。
# =============================================================================

# Milvus 向量数据库 — 长期记忆（启用授权后必须带 token，格式 root:<密码>）
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=root:<与 MILVUS_ROOT_PASSWORD 相同>

# Milvus root 密码（compose 侧启用授权用；须与上面 MILVUS_TOKEN 中的密码一致）
# MILVUS_ROOT_PASSWORD=<openssl rand -hex 24>

# MongoDB 文档数据库 — 认证 root 用户（compose 侧，mongo:8 以 --auth 启动）
MONGO_INITDB_ROOT_USERNAME=elysia
# MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 24>

# MongoDB 连接串（应用侧）— 启用认证后必须携带用户名/密码
# MONGODB_URI=mongodb://elysia:<与 MONGO_INITDB_ROOT_PASSWORD 相同>@127.0.0.1:27017/default?authSource=admin

# MinIO 对象存储（Milvus standalone 内部依赖）— 凭据仅用于调试控制台
MINIO_ROOT_USER=elysia-minio
# MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# =============================================================================
# 工具 — 可选
# =============================================================================

# Tavily 网页搜索 (https://www.tavily.com/)
# TAVILY_API_KEY=tvly-dev-your-key-here
