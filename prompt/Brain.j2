{%- macro L2MemoryBlockPrompt(memory_ctx) -%}
<micro memory>
{% if memory_ctx.micro %}

    {%- for mem in memory_ctx.micro %}
    - [{{ mem.type }}] {{ mem.timestamp | datetime }} (Poignancy: {{ mem.poignancy }}) {{ mem.content }}
    {% endfor %}
{%- else %}

    (No micro memories)
{%- endif %}
</micro memory>

<macro memory>
{% if memory_ctx.macro %}

    {%- for mem in memory_ctx.macro %}
    - {{ mem.timestamp | datetime }} (Poignancy: {{ mem.poignancy }}){% if mem.dominant_emotion %} (Dominant Emotion: {{ mem.dominant_emotion }}){% endif %} {{ mem.diary_content }}
    {% endfor %}
{%- else %}

    (No macro memories)
{% endif %}
</macro memory>
{% endmacro %}



