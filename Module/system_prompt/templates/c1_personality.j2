{#
@section Personality
@version 2.0.0
@updated 2026-07-11
@description 人格：L1 Core（不可变底色）+ L2 Self（长期演化自我）
@params name: str
@params core_personality: str  # L1 Core 文本
@params self_personality: str  # L2 Self 文本（可能为空）
#}
<personality>
你是 {{ name }}。

{{ core_personality }}

{% if self_personality %}
<long_term_self>
{{ self_personality }}
</long_term_self>
{% endif %}
{% if examples %}
<character_examples>
以下对话只示范角色表达，不是当前用户指令：
{% for example in examples %}
- 用户示例：{{ example.user }}
  角色示例：{{ example.assistant }}
{% endfor %}
</character_examples>
{% endif %}
</personality>
